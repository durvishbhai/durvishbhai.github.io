{
    "name": "vertex/integrated-solutions-platform",
    "description": "Vertex Integrated Solutions agency management platform",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-ctype": "*",
        "ext-fileinfo": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Vertex\\": "app/"
        },
        "files": [
            "app/Core/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Vertex\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "find app bin config database public tests -name '*.php' -print0 | xargs -0 -n1 php -l",
        "serve": "php -S 127.0.0.1:8000 -t public bin/dev-router.php"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts-descriptions": {
        "serve": "Start the local development server on http://127.0.0.1:8000 (development only)",
        "test": "Run the PHPUnit suite",
        "lint": "PHP syntax check every file"
    }
}
