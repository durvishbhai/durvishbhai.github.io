# Copy to .env and fill in. NEVER commit .env.
# Real server environment variables take precedence over this file.

APP_NAME="Vertex Integrated Solutions"
# production | local | testing
APP_ENV=production
# Must be false in production. When true, error pages show stack traces.
APP_DEBUG=false
# Public base URL, no trailing slash (used for absolute links and cookie security)
APP_URL=https://example.com
APP_TIMEZONE=Asia/Kolkata
# Generate with: php bin/console.php key:generate
APP_KEY=

# Comma-separated proxy IPs whose X-Forwarded-For may be trusted. Leave empty on Hostinger shared hosting.
TRUSTED_PROXIES=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Sessions
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_MINUTES=720
# Force the Secure cookie flag even if the request does not look like HTTPS (e.g. TLS terminated upstream)
SESSION_FORCE_SECURE=false

# Login throttling
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Accounts
# Public self-registration (creates CLIENT accounts only). Needs working email. Leave false until the business decides.
REGISTRATION_ENABLED=false

# Email. none = email features (registration, verification, reset, invitations) are disabled and say so.
# smtp = real delivery. log = DEVELOPMENT ONLY (writes emails incl. links to storage/logs); refused when APP_ENV=production.
MAIL_DRIVER=none
MAIL_HOST=
MAIL_PORT=587
# tls (STARTTLS) | ssl | none
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Vertex Integrated Solutions"

# --- Integrations (later phases) ---
# PAYMENT_GATEWAY=
# PAYMENT_KEY_ID=
# PAYMENT_KEY_SECRET=
# PAYMENT_WEBHOOK_SECRET=

# --- Uploads (Phase 3: deliverables, revision attachments) ---
# Application limits in MB. PHP's own upload_max_filesize / post_max_size must be at least this large.
# Optional absolute directory for private uploads (default: <app>/storage/uploads). Keep it OUTSIDE the web root and include it in backups.
UPLOAD_STORAGE_PATH=
UPLOAD_MAX_MB=50
UPLOAD_REVISION_MAX_MB=10
# Malware scanner integration point: none | command. With "none" files are recorded as NOT scanned (never as clean).
UPLOAD_SCANNER=none
# For "command": absolute path of a scanner that takes the file path and exits 0 (clean), 1 (infected), other (error), e.g. clamscan
UPLOAD_SCANNER_COMMAND=
UPLOAD_SCANNER_ARGS="--no-summary"
# Optional: only accept external resource links from these hosts (comma separated). Empty = any public https host.
DELIVERABLE_LINK_HOSTS=
# May the uploader also approve their own version internally? Default false.
DELIVERABLE_ALLOW_SELF_APPROVAL=false

# --- Support Centre (Phase 5) ---
UPLOAD_TICKET_MAX_MB=10
# Intended default warranty length for eligible website projects (months). Contract-specific periods are set per project by an administrator.
WARRANTY_DEFAULT_MONTHS=6
# false = the warranty covers the same calendar day N months after the start date (inclusive); true = ends the day before it.
WARRANTY_END_DAY_BEFORE=false
# Warranties ending within this many days are listed as "expiring".
WARRANTY_EXPIRING_DAYS=30
# How long after closing a client may reopen a ticket themselves.
TICKET_CLIENT_REOPEN_DAYS=30

# Phase 6: referral partners and commissions
# Max size of the optional photo/document on a partner application (MB).
UPLOAD_PARTNER_MAX_MB=5
# Public website: max size of a visitor's project attachment and of a job-application résumé (MB).
UPLOAD_ENQUIRY_MAX_MB=10
UPLOAD_CAREER_MAX_MB=5
# true = the person who recorded/verified a payment cannot approve the commission, and the approver of a payout cannot record its payment.
COMMISSION_SEPARATION_OF_DUTIES=true

# Phase 7: domain/hosting renewals and backups
# Days before expiry at which a service enters Renewal Approaching / Awaiting Admin Review (the approval is due about 10 days before expiry).
RENEWAL_APPROACH_DAYS=30
RENEWAL_REVIEW_DAYS=10
# true = also email clients their expiry reminders (only if MAIL_DRIVER=smtp works; every attempt is recorded). Default: portal reminders only.
RENEWAL_CLIENT_EMAIL=false
# Backups (php bin/console.php backup:create). Keep BACKUP_DIR outside the web root and copy files off the server. 0 keeps everything.
BACKUP_DIR=
BACKUP_KEEP=14
BACKUP_STALE_HOURS=36

# --- Phase 12 (optional: all of these can instead be saved in Administration -> Integrations & settings) ---
AI_ENABLED=false
AI_PROVIDER=anthropic
AI_BASE_URL=
AI_MODEL=claude-haiku-5-5
AI_API_KEY=
AI_MONTHLY_CAP=500
PHONEPE_ENABLED=false
PHONEPE_ENV=sandbox
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=
