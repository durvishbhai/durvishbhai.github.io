# Copy to .env.testing. Use a THROWAWAY database whose name ends in _test or _phpunit:
# the integration tests drop every table in it. Tests refuse to run against any other name.
APP_ENV=testing
APP_DEBUG=true
APP_KEY=base64:phpunit-only-key-not-a-secret-0123456789abcdef
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vertex_phpunit
DB_USERNAME=
DB_PASSWORD=
