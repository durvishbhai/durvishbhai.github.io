# Private application storage (uploads, logs, sessions, cache). Never serve anything from here.
# The web server's document root must be public/; this file is a second line of defence for hosts
# where the whole application folder is the document root.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .phar
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
